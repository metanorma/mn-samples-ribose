  <span class="stem">
    <m:oMathPara>
  <m:oMathParaPr><m:jc m:val="left"/></m:oMathParaPr><m:oMath>
    <m:r><m:t>D</m:t></m:r><m:d><m:dPr><m:begChr m:val="("></m:begChr><m:sepChr m:val=""></m:sepChr><m:endChr m:val=")"></m:endChr></m:dPr><m:e><m:r><m:t>K</m:t></m:r><m:r><m:t>,</m:t></m:r><m:r><m:t>m</m:t></m:r></m:e></m:d>
  </m:oMath>
</m:oMathPara>

  </span></p></td><td valign="top"><p class="MsoNormal"><a name="_992b26c9-0043-0da5-82bb-d04c1d567225" id="_992b26c9-0043-0da5-82bb-d04c1d567225"></a>Decryption of the message <span class="stem"><m:oMath>
