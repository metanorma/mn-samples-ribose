<td id="_908f2e85-3e60-5a34-b19b-b7d49846ff6d" valign="top" align="left">125</td>
</tr><tr id="_a877ca7c-5b45-691f-a554-664342fc5c39"><td id="_30785b67-3957-de5b-741b-f9f0d1efb7c3" valign="top" align="left"><tt>\[</tt></td>
<td id="_6f2e31c0-313a-3d77-4584-eeee071cfc35" valign="top" align="left">Open square brace</td>
